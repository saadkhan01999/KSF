# =============================================================================
#  KSF on a Hostinger VPS — the settings file (deploy/.env)
# -----------------------------------------------------------------------------
#  Copy it on the server, lock it, fill it in (deploy/HOSTINGER_DEPLOYMENT.txt
#  Part 5), then check it:
#
#    cp deploy/hostinger.env.example deploy/.env && chmod 600 deploy/.env
#    nano deploy/.env
#    ksf run --rm app node backend/dist/cli/preflight.js
#
#  Never put this file in Git. Every line is explained in docs/ENVIRONMENT.md.
#  NODE_ENV, PORT, COOKIE_SECURE and TRUST_PROXY are set by
#  deploy/docker-compose.yml and are not needed here.
# =============================================================================

# --- the address (your domain, with https) ----------------------------------
PUBLIC_APP_URL=https://ksfpharmacy.com
PUBLIC_ALLOWED_ORIGINS=https://ksfpharmacy.com,https://www.ksfpharmacy.com

# --- the database --------------------------------------------------------------
# The bundled MongoDB on this server (ksf ... --profile local-db):
MONGODB_URI="mongodb://mongo:27017/?replicaSet=rs0"
MONGODB_DB=ksf_pharmacy
# Or MongoDB Atlas instead (and allow this server's IP under Network Access):
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# --- sign-in secrets: two DIFFERENT random values ------------------------------
# Make each with:  openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'; echo
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- the platform owner (you, the Super Admin) ---------------------------------
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- e-mail: sign-up codes, password resets (Hostinger Business Email) --------
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=no-reply@ksfpharmacy.com
MAIL_PASSWORD=
MAIL_FROM=no-reply@ksfpharmacy.com
MAIL_FROM_NAME="KSF Pharmacy"

# --- must stay off for real pharmacies -----------------------------------------
SHOW_SIGNUP_CODE=false

# --- your business: website footer, terms, invoices ----------------------------
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_CITY=
BUSINESS_COUNTRY=Pakistan
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
SUPPORT_EMAIL=support@ksfpharmacy.com
SALES_EMAIL=
# The number on the Diamond Annual offer (call and WhatsApp):
SALES_PHONE="+92 371 3999656"
BUSINESS_WEBSITE=https://ksfpharmacy.com
SUPPORT_HOURS=
BUSINESS_NTN=
BUSINESS_STRN=

# --- referrals -----------------------------------------------------------------
# Days a pharmacy earns for each pharmacy that registers with its code (0 = off).
REFERRAL_REWARD_DAYS=15

# =============================================================================
#  Subscription payments — how pharmacies pay for Pro and Diamond Annual.
#  Fill in only what you use; a way of paying stays off until its lines are
#  complete. The pre-flight check above lists each one, and the Super Admin
#  console shows the same under Accounts > Payment methods, with the webhook
#  and return addresses to register. Details: docs/PAYMENTS.md.
# =============================================================================

# Which one the Pay button offers first: bank-transfer, stripe, jazzcash,
# easypaisa or gateway.
PAYMENT_PROVIDER=bank-transfer

# --- 1. Bank transfer or Raast (works today, no merchant account needed) ------
# The pharmacy pays into this account; the Super Admin confirms the transfer
# against the statement (Income > Payments waiting).
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
BANK_IBAN=
BANK_RAAST_ID=

# --- 2. Cards with Stripe (Stripe Checkout; renews itself) ---------------------
# Stripe Dashboard > Developers > API keys, and > Webhooks > Add endpoint:
#   https://ksfpharmacy.com/api/v1/payments/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RECURRING=true

# --- 3. JazzCash (hosted checkout) ----------------------------------------------
# From your JazzCash merchant portal. Register:
#   webhook (IPN): https://ksfpharmacy.com/api/v1/payments/webhook/jazzcash
#   return:        https://ksfpharmacy.com/api/v1/payments/return/jazzcash
# JAZZCASH_POST_URL is the form address in your merchant pack (the sandbox one
# starts https://sandbox.jazzcash.com.pk/). The website lets the payment form
# post there on its own.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_POST_URL=
JAZZCASH_MODE=sandbox
# Set true only after the sandbox cases in docs/PAYMENTS.md section 6 pass.
JAZZCASH_VERIFIED=false

# --- 4. Easypaisa (hosted checkout) ---------------------------------------------
#   webhook: https://ksfpharmacy.com/api/v1/payments/webhook/easypaisa
#   return:  https://ksfpharmacy.com/api/v1/payments/return/easypaisa
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_POST_URL=
EASYPAISA_MODE=sandbox
EASYPAISA_VERIFIED=false

# --- 5. A card-and-wallet gateway (Safepay, PayFast, Paymob, a bank's own) ----
#   webhook: https://ksfpharmacy.com/api/v1/payments/webhook/gateway
#   return:  https://ksfpharmacy.com/api/v1/payments/return/gateway
GATEWAY_NAME=
GATEWAY_CHECKOUT_URL=
GATEWAY_MERCHANT_ID=
GATEWAY_API_KEY=
GATEWAY_WEBHOOK_SECRET=
GATEWAY_MODE=sandbox
GATEWAY_VERIFIED=false
