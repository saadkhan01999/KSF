# =============================================================================
#  KSF Pharmacy Management System — settings
#  -----------------------------------------------------------------------------
#  Copy this file to .env and fill in the three things marked REQUIRED.
#  DATABASE_SETUP.md explains each step with screenshots-in-words.
#
#  Rules of the file:
#    - One setting per line, NAME=value, no spaces around "=".
#    - A value containing # or spaces must be in double quotes: "a#b c".
#    - Never commit .env or share it: it holds the database password and the
#      keys that sign every sign-in.
# =============================================================================

NODE_ENV=development
PORT=8790
# commercial (the live service) or university (an isolated copy for academic
# submission: online payments off, the edition shown on every screen). The
# university copy is made with: npm run university:copy
KSF_EDITION=commercial

# Where people open KSF in the browser, and which sites may call the API.
PUBLIC_APP_URL=http://localhost:5180
PUBLIC_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:4180
# Behind Nginx or a load balancer, which proxy addresses to believe for the
# visitor's real IP (Express "trust proxy"): loopback, uniquelocal, an IP, or
# a number of proxy hops (Railway: 1; Vercel in front of Railway: 2).
TRUST_PROXY=loopback

# -----------------------------------------------------------------------------
#  1. DATABASE — REQUIRED
#  MongoDB Atlas: Database > Connect > Drivers, copy the connection string and
#  put your database user's password in place of <password>. A local MongoDB:
#  mongodb://127.0.0.1:27017/?replicaSet=rs0  (see DATABASE_SETUP.md)
# -----------------------------------------------------------------------------
MONGODB_URI="PASTE-YOUR-MONGODB-CONNECTION-STRING-HERE"
MONGODB_DB=ksf_pharmacy

# -----------------------------------------------------------------------------
#  2. SIGN-IN KEYS — REQUIRED
#  Two long random secrets, different from each other. Generate them with:
#      npm run secrets -- --write
#  Changing them later signs everybody out (useful if you suspect a leak).
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=ksf-pharmacy
JWT_AUDIENCE=ksf-web
# The access token lives in the browser's memory for this long...
JWT_ACCESS_MINUTES=15
# ...and the refresh token (an HttpOnly cookie, replaced on every use) this long.
JWT_REFRESH_DAYS=7
REFRESH_COOKIE_NAME=ksf_refresh
DEVICE_COOKIE_NAME=ksf_device
# true when the site is served over HTTPS (always, in production).
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
#  3. THE PLATFORM SUPER ADMIN — REQUIRED for the first start
#  The one account that runs the whole platform. It is created the first time
#  the server starts, and only then: after that, change the e-mail address and
#  password from the Super Admin's own profile page — this file is not read
#  for it again. Use at least 12 characters with upper and lower case, a
#  number and a symbol, and keep the quotes.
# -----------------------------------------------------------------------------
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
#  Sessions and sign-in protection
# -----------------------------------------------------------------------------
SESSION_IDLE_MINUTES=45
SESSION_ABSOLUTE_HOURS=72
STEP_UP_MINUTES=10
DEVICE_LIMIT_DESKTOP=1
DEVICE_LIMIT_MOBILE=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_PER_IP=60
PASSWORD_MIN_LENGTH=12

# -----------------------------------------------------------------------------
#  E-mail (sign-up codes, password resets, support replies)
#  console = print to the server window and save to .data/outbox (development)
#  smtp    = send for real; fill in MAIL_HOST, MAIL_USER and MAIL_PASSWORD
# -----------------------------------------------------------------------------
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@ksfpharmacy.pk
MAIL_FROM_NAME=KSF Pharmacy
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=""

# -----------------------------------------------------------------------------
#  Sign-up codes and referrals
# -----------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS=5
# Testing only: show the sign-up code on the screen as well as e-mailing it,
# so sign-up works without a mail server. Anyone can then sign up with an
# address they do not own. Leave false for real customers.
SHOW_SIGNUP_CODE=false
REFERRAL_TRIAL_DAYS=15
REFERRAL_MAX_USES=100
REFERRAL_MAX_PER_DAY=10
REFERRAL_MAX_PER_IP_PER_DAY=3
REGISTER_MAX_PER_IP=20

# -----------------------------------------------------------------------------
#  Subscription payments — docs/PAYMENTS.md
#  A provider stays switched off until its own settings are filled in.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=bank-transfer
PAYMENT_WEBHOOK_SECRET=
# Stripe (cards on Stripe Checkout, plans that renew themselves). Set
# PAYMENT_PROVIDER=stripe to offer it first. Webhook endpoint to add in the
# Stripe Dashboard: https://<your API>/api/v1/payments/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RECURRING=true
STRIPE_EXPIRY_MINUTES=60
STRIPE_TIMEOUT_MS=15000
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
BANK_IBAN=
BANK_RAAST_ID=
GATEWAY_NAME=
GATEWAY_CHECKOUT_URL=
GATEWAY_MERCHANT_ID=
GATEWAY_API_KEY=
GATEWAY_WEBHOOK_SECRET=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_POST_URL=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_POST_URL=

# -----------------------------------------------------------------------------
#  Barcode lookup: fill in a new medicine from the open product databases
#  when KSF does not know its barcode (only product numbers are sent).
# -----------------------------------------------------------------------------
BARCODE_LOOKUP_ONLINE=true
BARCODE_LOOKUP_TIMEOUT_MS=3500

# -----------------------------------------------------------------------------
#  Data import and backups
# -----------------------------------------------------------------------------
MIGRATION_MAX_ROWS=20000
MIGRATION_BACKUP_DIR=.data/backups
BACKUP_DIR=.data/backups

# -----------------------------------------------------------------------------
#  Your business, shown on the public website and in e-mails
# -----------------------------------------------------------------------------
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_CITY=
BUSINESS_COUNTRY=Pakistan
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
SUPPORT_EMAIL=
SALES_EMAIL=
BUSINESS_WEBSITE=
SUPPORT_HOURS=
BUSINESS_NTN=
BUSINESS_STRN=
